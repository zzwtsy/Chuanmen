# Android Studio / IntelliJ 状态默认忽略；只共享团队配置。
*.iml
*.iws
/.idea/*
!/.idea/.gitignore
!/.idea/codeStyles/
!/.idea/inspectionProfiles/
!/.idea/runConfigurations/
!/.idea/vcs.xml
