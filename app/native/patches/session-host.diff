+/// Android 共享进程 runtime，保留完整原生宿主配置；不创建每会话驱动线程。
+#[cfg(feature = "management-rpc")]
+pub fn native_android_instance_manager(runtime: tokio::runtime::Handle) -> NativeInstanceManager {
+    let mut factory = NativeInstanceFactory::new(CoreProcessRuntime::new())
+        .with_runtime_handle(Some(runtime.clone()));
+    factory.shared_runtime = true;
+    InstanceManager::new(factory, Some(runtime))
+}
+
+/// 独立的安装确认入口；入队和实际安装分别表达。
+pub fn enqueue_android_tun(
+    instance: &NativeCoreInstance,
+    request: crate::android_tun::TunRequest,
+) -> Result<(), crate::android_tun::TunError> {
+    #[cfg(all(feature = "tun", mobile))]
+    {
+        let host = instance.runtime_host::<NativeInstanceRuntimeHost>()
+            .ok_or(crate::android_tun::TunError::QueueClosed)?;
+        host.enqueue_android_tun(request)
+    }
+    #[cfg(not(all(feature = "tun", mobile)))]
+    {
+        let _ = instance;
+        request.cancel();
+        Err(crate::android_tun::TunError::QueueClosed)
+    }
+}
